<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    {{> header}}
    <h1>This is Blog Page</h1>
    <ul>
        {{#if data}}
        {{#each data}}
        <li>
            <h3>{{Title}}</h3>
            <p>{{Writer}}</p>
        </li>
        <a href="/blogs/{{_id}}">Read More</a>
        {{/each}}
        {{else}}
        <h4>No Data Found</h4>
        {{/if}}
    </ul>
</body>
</html>